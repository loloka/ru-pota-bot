# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCDefGhIJklMNopQRstUVwxYZ

# Main Chat ID (Closed group for communication and moderation)
MAIN_CHAT_ID=-1001234567890

# Activity Channel ID (Channel/Group for broadcasting spots)
ACTIVITY_CHANNEL_ID=-1000987654321

# Bot Admin Telegram ID (for approving callsign registrations and moderation)
ADMIN_ID=123456789

# Telegram API Root (Optional: for bypassing blocks via HTTP mirrors like Cloudflare Workers)
# TG_API_ROOT=https://tg-proxy.your-username.workers.dev

# SOCKS5 Proxy (Optional: alternative to TG_API_ROOT for bypassing blocks)
# TG_PROXY=socks5h://user:pass@1.2.3.4:1080

# POTA API Base URL (default is https://api.pota.app)
POTA_API_BASE_URL=https://api.pota.app

# Cluster polling interval in milliseconds (default: 60000 = 1 minute)
POLL_INTERVAL_MS=60000

# Allowed park prefixes for global cluster filtering, comma separated
ALLOWED_PREFIXES=RU-,BY-,KZ-

# Spot pin duration in minutes before automatic unpinning in channel and group (default: 30)
SPOT_PIN_DURATION_MINUTES=30

# Cluster spot anti-spam cooldown in minutes (suppresses repetitive RBN skimmers on same band & mode, default: 20)
CLUSTER_SPOT_COOLDOWN_MINUTES=20

# Password for the web admin panel (Login is always 'admin')
ADMIN_PASSWORD=my_super_secret_password

# RU-POTA Shield Settings (Antispam Gatekeeper, Face-Control & Captcha)
SHIELD_ENABLED=true
SHIELD_CAPTCHA_TIMEOUT=120
SHIELD_STRICT_NAME_CHECK=true
SHIELD_BLOCK_NEWBIE_LINKS=true

