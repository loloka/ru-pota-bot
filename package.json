{
  "name": "ru-pota",
  "version": "1.16.84",
  "description": "Telegram Bot for RU-POTA (Parks on the Air) Community",

  "main": "src/bot/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/bot/index.js",
    "start": "node src/bot/index.js",
    "test": "node test_shield.js && node test_links_audit.js && node test_notifications.js && node test_web_auth.js && node test_telegram_link.js && node test_oopt_search.js && node test_regions_stats.js && node test_location_service.js && node test_service_health.js && node test_coord_parse.js",
    "sync:pota": "node -e \"import('./src/services/ooptService.js').then(m => m.syncPotaParksWithApi())\"",
    "update:oopt": "node src/scripts/downloadOopt.js",
    "webapp:dev": "vite src/webapp",
    "webapp:build": "vite build src/webapp",
    "build": "npm run webapp:build"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "better-sqlite3": "^11.0.0",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "https-proxy-agent": "^7.0.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socks-proxy-agent": "^10.1.0",
    "telegraf": "^4.16.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
